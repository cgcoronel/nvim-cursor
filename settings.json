{
  // Window & UI
  "window.zoomLevel": 3,
  "window.newWindowDimensions": "maximized",
  "window.titleBarStyle": "custom",
  "workbench.navigationControl.enabled": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "none",
  "window.commandCenter": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 15,
  "explorer.compactFolders": false,
  // Editor appearance & behavior
  "editor.fontFamily": "VictorMono Nerd Font",
  "editor.fontSize": 13,
  "editor.lineHeight": 22,
  "editor.letterSpacing": 1,
  "editor.fontWeight": "500",
  "editor.guides.indentation": false,
  "editor.glyphMargin": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "phase",
  "editor.smoothScrolling": true,
  "editor.lineNumbers": "on",
  "editor.stickyScroll.enabled": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [],
  // Formatters
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // Terminal
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": "bold",
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.tabs.enabled": false,
  // Breadcrumbs & navigation
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.icons": false,
  "breadcrumbs.symbolPath": "off",
  "zenMode.hideLineNumbers": false,
  "vscode-neovim.neovimInitVimPaths.darwin": "/Users/Cristian/.config/nvim-cursor/init.lua",
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "vscode-neovim.compositeKeys": {
    "kj": {
      "command": "vscode-neovim.escape"
    }
  },
  // Git & project management
  "projectManager.git.baseFolders": [
    "/Users/Cristian/projects/xepelin"
  ],
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  "git.decorations.enabled": false,
  // TypeScript/JavaScript specific
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "shortest",
  "javascript.updateImportsOnFileMove.enabled": "always",
  // AWS/Pulumi specific
  "files.associations": {
    "*.tf": "hcl",
    "*.tfvars": "hcl"
  },
  "yaml.schemas": {
    "https://json.schemastore.org/pulumi.json": "**/Pulumi.yaml"
  },
  // Performance optimizations
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.pulumi/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.pulumi": true,
    "**/coverage": true
  },
  "files.simpleDialog.enable": true,
  // Node.js development optimizations
  "npm.enableScriptExplorer": true,
  "npm.exclude": "**/node_modules/**",
  // Extensions & other
  "extensions.ignoreRecommendations": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",
  "workbench.agentsWindowButton.enabled": false,
  "workbench.colorCustomizations": {
    "terminal.background": "#151823",
    "panel.background": "#151823",
    "terminal.border": "#20242f",
    "tab.activeBackground": "#1b2233",
    "tab.inactiveBackground": "#151823",
    "titleBar.activeBackground": "#151823",
    "titleBar.inactiveBackground": "#151823",
    "titleBar.activeForeground": "#6b728a",
    "titleBar.inactiveForeground": "#6b728a",
    "window.activeBorder": "#000000",
    // Input Search
    "quickInputTitle.background": "#242732",
    "input.border": "#242732",
    "focusBorder": "#242732",
    // borde
    "surface.border": "#151823",
    "[Mayukai Mono]": {
      "editorGroupHeader.tabsBackground": "#151823",
      "editorGroupHeader.noTabsBackground": "#151823",
      // linea de titulo
      "titleBar.border": "#151823",
      // linea header/editor
      // "editorGroupHeader.border": "#20242f",
      // linea entre grupos/paneles
      "editorGroup.border": "#20242f",
      // separador general de paneles
      "panel.border": "#20242f",
      // sidebar
      "sideBar.border": "#20242f",
      // Sidebar
      "sideBar.background": "#151823",
      "sideBarSectionHeader.background": "#151823",
      "sideBarTitle.foreground": "#6b728a",
      "activityBar.background": "#151823",
      "activityBar.inactiveForeground": "#6b728a",
      "auxiliaryBar.background": "#151823",
      "auxiliaryBar.border": "#20242f"
    }
  },
  "window.autoDetectColorScheme": false,
  "workbench.colorTheme": "Mayukai Mono",
  "workbench.activityBar.location": "hidden",
  "workbench.panel.showLabels": false,
  "git.showActionButton": false,
  "git.showCommitInput": false,
  "claudeCode.preferredLocation": "sidebar",
  "diffEditor.hideUnchangedRegions.enabled": true,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "claudeCode.focusView": true,
  "editor.minimap.enabled": false,
  "chat.titleBar.signIn.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "workbench.editor.editorActionsLocation": "hidden",
  "chat.viewSessions.enabled": false,
  "claudeCode.hideOnboarding": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never"
}