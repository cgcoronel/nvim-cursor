{
  // Window & UI
  "window.zoomLevel": 2.8,
  "window.newWindowDimensions": "maximized",
  "window.titleBarStyle": "custom",
  "workbench.navigationControl.enabled": false,
  //  "workbench.editor.showTabs": "single",
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "none",
  "window.commandCenter": false,
  //  "workbench.panel.showLabels": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  // "breadcrumbs.enabled": true,
  // "breadcrumbs.filePath": "last",
  // "breadcrumbs.symbolPath": "off",
  // "breadcrumbs.icons": true,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 15,
  "explorer.compactFolders": false,
  // Editor appearance & behavior
  "editor.fontFamily": "VictorMono Nerd Font",
  //  "editor.fontSize": 12.5,
  "editor.fontSize": 11,
  //  "editor.lineHeight": 24,
  "editor.lineHeight": 20,
  //  "editor.letterSpacing": 0.5,
  "editor.letterSpacing": 1,
  "editor.fontWeight": "500",
  "editor.guides.indentation": false,
  "editor.glyphMargin": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "phase",
  "editor.smoothScrolling": true,
  "editor.lineNumbers": "on",
  "editor.stickyScroll.enabled": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [],
  // Terminal
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.fontWeight": "bold",
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.tabs.enabled": false,
  // Breadcrumbs & navigation
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.icons": false,
  "breadcrumbs.symbolPath": "off",
  "zenMode.hideLineNumbers": false,
  "vscode-neovim.neovimInitVimPaths.darwin": "/Users/Cristian/.config/nvim-cursor/init.lua",
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "vscode-neovim.compositeKeys": {
    "kj": {
      "command": "vscode-neovim.escape"
    }
  },
  // Git & project management
  "projectManager.git.baseFolders": [
    "/Users/Cristian/projects/xepelin"
  ],
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  "git.decorations.enabled": false,
  // TypeScript/JavaScript specific
  "typescript.preferences.includePackageJsonAutoImports": "auto",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.enabled": true,
  "typescript.validate.enable": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "javascript.preferences.includePackageJsonAutoImports": "auto",
  "javascript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  // AWS/Pulumi specific
  "files.associations": {
    "*.pulumi": "yaml",
    "*.tf": "hcl",
    "*.tfvars": "hcl"
  },
  "yaml.format.enable": true,
  "yaml.validate": true,
  "yaml.schemas": {
    "https://json.schemastore.org/pulumi.json": "**/Pulumi.*.yaml"
  },
  // Performance optimizations
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.pulumi/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.pulumi": true,
    "**/coverage": true
  },
  "files.simpleDialog.enable": true,
  // Node.js development optimizations
  "npm.enableScriptExplorer": true,
  "npm.exclude": "**/node_modules/**",
  // Cursor specific
  "cursor.composer.textSizeScale": 1.15,
  "cursor.composer.shouldAutoScrollToBottom": false,
  // Extensions & other
  "extensions.ignoreRecommendations": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "hediet.vscode-drawio.resizeImages": null,
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",
  "workbench.agentsWindowButton.enabled": false,
  "workbench.colorCustomizations": {
    "terminal.background": "#151823",
    "panel.background": "#151823",
    "panel.border": "#20242f",
    "terminal.border": "#20242f",
    "tab.activeBackground": "#1b2233",
    "tab.inactiveBackground": "#151823",
    //
    "titleBar.activeBackground": "#151823",
    "titleBar.inactiveBackground": "#151823",
    "titleBar.activeForeground": "#6b728a",
    "titleBar.inactiveForeground": "#6b728a",
    "titleBar.border": "#20242f",
    "window.activeBorder": "#000000",
    "[Mayukai Mono]": {
      "editorGroupHeader.tabsBackground": "#151823",
      "editorGroupHeader.noTabsBackground": "#151823",
      // linea de titulo
      "titleBar.border": "#151823",
      // linea header/editor
      // "editorGroupHeader.border": "#20242f",
      // linea entre grupos/paneles
      "editorGroup.border": "#20242f",
      // separador general de paneles
      "panel.border": "#20242f",
      // sidebar
      "sideBar.border": "#20242f",
      // Sidebar
      "sideBar.background": "#151823",
      "sideBarSectionHeader.background": "#151823",
      "sideBarTitle.foreground": "#6b728a",
      "activityBar.background": "#151823",
      "activityBar.inactiveForeground": "#6b728a",
      "auxiliaryBar.background": "#151823",
      "auxiliaryBar.border": "#20242f"
    }
  },
  "window.autoDetectColorScheme": false,
  "workbench.colorTheme": "Mayukai Semantic Mirage",
  "workbench.activityBar.location": "hidden",
  "workbench.panel.showLabels": false,
  "git.showActionButton": false,
  "git.showCommitInput": false,
  "claudeCode.preferredLocation": "sidebar",
  "diffEditor.hideUnchangedRegions.enabled": true,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "claudeCode.focusView": true,
  "workbench.editor.editorActionsLocation": "hidden",
  "claudeCode.hideOnboarding": true,
}