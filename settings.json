{
  // Window & UI
  "window.zoomLevel": 2.2,
  "window.newWindowDimensions": "maximized",
  "window.titleBarStyle": "custom",
  "workbench.navigationControl.enabled": false,
  "workbench.editor.showTabs": "single",
  "workbench.editor.enablePreview": false,
  "workbench.panel.showLabels": false,
  "workbench.statusBar.visible": false,
  "workbench.tree.renderIndentGuides": "none",
  // Editor appearance & behavior
  "editor.fontFamily": "VictorMono Nerd Font",
  "editor.fontSize": 12.5,
  "editor.lineHeight": 24,
  "editor.letterSpacing": 0.5,
  "editor.fontWeight": "500",
  "editor.guides.indentation": false,
  "editor.glyphMargin": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "phase",
  "editor.smoothScrolling": true,
  "editor.lineNumbers": "on",
  "editor.stickyScroll.enabled": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [],
  // Terminal
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.fontWeight": "bold",
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.tabs.enabled": false,
  // Breadcrumbs & navigation
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.icons": false,
  "breadcrumbs.symbolPath": "off",
  "zenMode.hideLineNumbers": false,
  "vscode-neovim.neovimInitVimPaths.darwin": "/Users/Cristian/.config/nvim-cursor/init.lua",
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "vscode-neovim.compositeKeys": {
    "kj": {
      "command": "vscode-neovim.escape"
    }
  },
  // Git & project management
  "projectManager.git.baseFolders": ["/Users/Cristian/projects/xepelin"],
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  // TypeScript/JavaScript specific
  "typescript.preferences.includePackageJsonAutoImports": "auto",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.enabled": true,
  "typescript.validate.enable": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "javascript.preferences.includePackageJsonAutoImports": "auto",
  "javascript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  // AWS/Pulumi specific
  "files.associations": {
    "*.pulumi": "yaml",
    "*.tf": "hcl",
    "*.tfvars": "hcl"
  },
  "yaml.format.enable": true,
  "yaml.validate": true,
  "yaml.schemas": {
    "https://json.schemastore.org/pulumi.json": "**/Pulumi.*.yaml"
  },
  // Performance optimizations
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.pulumi/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.pulumi": true,
    "**/coverage": true
  },
  "files.simpleDialog.enable": true,
  // Node.js development optimizations
  "npm.enableScriptExplorer": true,
  "npm.exclude": "**/node_modules/**",
  // Cursor specific
  "cursor.composer.textSizeScale": 1.15,
  "cursor.composer.shouldAutoScrollToBottom": false,
  // Extensions & other
  "extensions.ignoreRecommendations": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "hediet.vscode-drawio.resizeImages": null,
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",
  "workbench.colorTheme": "Monokai Pro (Filter Ristretto)",
  "workbench.agentsWindowButton.enabled": false
}
